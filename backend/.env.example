# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND - HỆ THỐNG QUẢN LÝ NHÀ HÀNG
# ========================================================

# 1. Cổng chạy máy chủ (Render/Heroku/App Engine sẽ tự động cấp giá trị PORT)
PORT=5000

# 2. Chuỗi kết nối Cơ sở dữ liệu đám mây MongoDB Atlas
# HÃY DÁN CHUỖI KẾT NỐI MONGODB ATLAS CỦA BẠN VÀO ĐÂY (thay <password> bằng mật khẩu thật):
MONGODB_URI=mongodb+srv://admin:MatKhauCuaBan123@cluster0.abcde.mongodb.net/restaurant_db?retryWrites=true&w=majority

# 3. Mã bí mật JWT bảo mật
JWT_SECRET=super_secret_restaurant_cloud_key_2026

# 4. Cấu hình Lưu trữ ảnh đám mây Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 5. Cấu hình Cổng thanh toán chuyển khoản VietQR tự động
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=NHA HANG AM THUC VIET

# 6. Địa chỉ URL của Frontend React (khi chạy local hoặc link Vercel)
CLIENT_URL=http://localhost:5173
